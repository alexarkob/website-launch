# Copy to `.env` for `astro dev`, or `.dev.vars` for `wrangler pages dev`.
# Never commit real keys. Restart the server after editing.
#
# For Cloudflare production: Pages → Settings → Environment variables
# (and enable the AI binding for workers-ai when using the Pages binding).

# Gemini Flash — FREE-TIER KEY (default in the UI)
# https://aistudio.google.com/apikey
# No paid key required for free-tier limits.
GEMINI_API_KEY=

# Claude Sonnet — PAID KEY REQUIRED
# https://console.anthropic.com/
# Billed usage; no free Anthropic API tier for this model.
ANTHROPIC_API_KEY=

# Workers AI (Llama) — FREE-TIER ALLOTMENT
# Free Cloudflare account OK within free Workers AI limits.
# https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Softball lineup app — required in production; local `astro dev` falls back
# to admin PIN `devpin` and a dev-only session secret if these are empty.
SOFTBALL_ADMIN_PIN=
SOFTBALL_SESSION_SECRET=

# Spotify walk-up search + playlist (create an app at https://developer.spotify.com)
# Redirect URI: http://localhost:4321/api/softball/spotify/callback
# Production: https://arkoalexbhattacharyya.org/api/softball/spotify/callback
# Also: https://arko-portfolio.pages.dev/api/softball/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
