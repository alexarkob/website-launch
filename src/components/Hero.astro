---
import { site } from "../content/site";
---

<header class="relative isolate min-h-[100svh] overflow-hidden">
  <div class="atmosphere pointer-events-none absolute inset-0 -z-10">
    <div
      class="absolute inset-0"
      style="background:
        radial-gradient(ellipse 90% 70% at 15% 20%, color-mix(in srgb, var(--color-signal) 22%, transparent), transparent 55%),
        radial-gradient(ellipse 70% 60% at 85% 75%, color-mix(in srgb, var(--color-ink) 18%, transparent), transparent 50%),
        linear-gradient(165deg, var(--color-paper) 0%, var(--color-paper-deep) 48%, #d9e4ea 100%);"
    >
    </div>
    <div class="grain absolute inset-[-20%] opacity-[0.07] mix-blend-multiply" aria-hidden="true"></div>
  </div>

  <nav class="mx-auto flex w-full max-w-6xl items-center justify-between px-6 py-6 md:px-10">
    <a href="/" class="font-display text-lg font-semibold tracking-tight text-ink">
      {site.name}
    </a>
    <div class="flex items-center gap-6 text-sm font-medium text-ink-soft">
      <a href="#projects" class="transition hover:text-signal">Projects</a>
      <a href="#contact" class="transition hover:text-signal">Contact</a>
    </div>
  </nav>

  <div class="mx-auto flex min-h-[calc(100svh-5.5rem)] w-full max-w-6xl flex-col justify-center px-6 pb-20 pt-8 md:px-10">
    <p class="hero-rise text-sm font-medium uppercase tracking-[0.22em] text-signal">
      {site.hero.intro}
    </p>
    <h1
      class="hero-rise hero-rise-delay-1 font-display mt-4 max-w-4xl text-[clamp(2.75rem,8vw,5.75rem)] font-semibold leading-[1.02] tracking-tight text-ink text-balance"
    >
      {site.hero.name}
    </h1>
    <p
      class="hero-rise hero-rise-delay-2 mt-6 max-w-2xl text-lg leading-relaxed text-muted md:text-xl"
    >
      {site.hero.body}
    </p>
    <div class="hero-rise hero-rise-delay-3 mt-10 flex flex-wrap items-center gap-4">
      <a
        href="#projects"
        class="inline-flex items-center justify-center rounded-sm bg-ink px-6 py-3 text-sm font-semibold text-paper transition hover:bg-ink-soft"
      >
        See the work
      </a>
      <a
        href="#contact"
        class="inline-flex items-center justify-center rounded-sm border border-ink/20 bg-transparent px-6 py-3 text-sm font-semibold text-ink transition hover:border-signal hover:text-signal"
      >
        Get in touch
      </a>
    </div>
  </div>
</header>
